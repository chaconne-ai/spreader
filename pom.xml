<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.chaconne-ai</groupId>
    <artifactId>spreader</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>spreader</name>
    <description>
        Decentralized clustering for Java on the Gossip/SWIM protocol: instances form
        a cluster in seconds, elect a leader, keep a live view of every member, and
        multicast or unicast messages to one another.

        Every node runs the same code and holds the same complete member list.
        Membership spreads by SWIM gossip, point to point between randomly chosen
        peers and never through a coordinator, so no node exists whose loss stops the
        rest. A node that dies is found by direct probe, then by indirect probe
        through other members, then by a suspect timeout. There is no ZooKeeper, no
        etcd and no external coordinator anywhere in the picture.

        Leadership needs no consensus round: whoever seizes the cluster port is the
        leader, and the operating system already guarantees that only one process can
        hold a port. That is what keeps the library this small, and the limit it
        implies is stated rather than hidden: this is not Raft, so under a network
        partition two sides can each hold a leader. Recovery is sub-second and every
        occurrence is counted.

        Messaging comes with membership: multicast, multicast to one application,
        unicast, unicast routed by consistent hash on a key, and send-to-leader, with
        round-robin, random and weighted balancing choosable per call. Independent
        named channels keep a busy topic from stalling a quiet one, and every dispatch
        queue is bounded, with whatever it drops counted rather than lost silently.

        Transports are pluggable: the built-in NIO one, or Netty, MINA and Grizzly,
        over either TCP or UDP. All four speak the same wire format, so nodes running
        different implementations can share one cluster.

        Per-channel observability is built in: throughput, concurrency, latency
        percentiles, error rates, buffer watermarks and a split-brain counter.

        Measured on the built-in transport over TCP: 18,464 cross-node
        request/response round trips per second, and 5.3 million in-process
        dispatches per second.
    </description>
    <url>https://github.com/chaconne-ai/spreader</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>ChaconneAI</name>
        <url>https://github.com/chaconne-ai</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>fredfeng</id>
            <name>Fred Feng</name>
            <email>paganini.fy@gmail.com</email>
            <organization>ChaconneAI</organization>
            <organizationUrl>https://github.com/chaconne-ai</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/chaconne-ai/spreader.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/chaconne-ai/spreader.git
        </developerConnection>
        <url>https://github.com/chaconne-ai/spreader</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/chaconne-ai/spreader/issues</url>
    </issueManagement>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Matches the version Spring Boot 4.1.0 manages, so spreader-commons
             and this module never disagree on it. -->
        <slf4j.version>2.0.18</slf4j.version>
    </properties>

    <dependencies>
        <!--
          The only non-optional dependency. slf4j-api is a facade, not an
          implementation: it pulls in nothing itself and binds to whatever the
          application already uses (Logback under Spring Boot, JUL, Log4j2...).
          With no binding on the classpath it degrades to a no-op plus one
          warning, so it never dictates how a downstream project logs.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!--
          The transports below are all optional, so nothing is forced on downstream
          projects: with none of them the built-in NIO transport is used. Add one and
          set spring.spreader.advanced.transport-provider to switch. Configuring a
          provider whose library is missing falls back to NIO with a warning instead
          of failing.
        -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>4.1.101.Final</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.mina</groupId>
            <artifactId>mina-core</artifactId>
            <version>2.2.4</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.glassfish.grizzly</groupId>
            <artifactId>grizzly-framework</artifactId>
            <version>2.3.35</version>
            <optional>true</optional>
        </dependency>

        <!-- Faster MPSC queue for inbound buffers. Affects throughput only,
             never correctness: without it a built-in ring buffer is used. -->
        <dependency>
            <groupId>org.jctools</groupId>
            <artifactId>jctools-core</artifactId>
            <version>4.0.5</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                    <compilerArgs>
                        <arg>-Xlint:all,-serial</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Javadoc jar for publishing. doclint is off: the docs here are written
              for people reading the source, and blocking a release over a missing
              @param tag helps nobody.

              Optional dependencies (Netty, MINA, Grizzly, JCTools) are on the
              javadoc classpath, so links into them resolve instead of erroring.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                    <encoding>UTF-8</encoding>
                    <charset>UTF-8</charset>
                    <docencoding>UTF-8</docencoding>
                    <failOnError>false</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.8</version>

                <!--
                  Loopback pinentry. The plugin runs gpg in batch mode, and with no
                  graphical pinentry installed gpg has nowhere to ask for the
                  passphrase, so it fails with "Inappropriate ioctl for device".
                  Loopback makes gpg take the passphrase from Maven instead, given
                  as -Dgpg.passphrase on the command line or set in settings.xml.
                -->
                <configuration>
                    <gpgArguments>
                        <arg>--pinentry-mode</arg>
                        <arg>loopback</arg>
                    </gpgArguments>
                </configuration>

                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>

                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.9.0</version>

                <extensions>true</extensions>

                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>central-portal-snapshots</id>
            <name>Central Portal Snapshots</name>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>

            <releases>
                <enabled>false</enabled>
            </releases>

            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
